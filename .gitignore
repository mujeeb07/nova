# =========================================================================
# 1. DEPENDENCIES (Never commit package installation folders)
# =========================================================================
node_modules/
jspm_packages/
web_modules/

# If your React app is in a subdirectory (e.g., 'client')
client/node_modules/
frontend/node_modules/

# =========================================================================
# 2. ENVIRONMENT VARIABLES & SECRETS (Crucial for API keys and database URIs)
# =========================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Subdirectory secrets
client/.env*
frontend/.env*

# =========================================================================
# 3. PRODUCTION & BUILD ARTIFACTS (Generated files should not be tracked)
# =========================================================================
# Express / Node build output (if using TypeScript or bundlers)
dist/
build/
out/

# React build outputs
client/build/
client/dist/
frontend/build/
frontend/dist/

# Serverless directories
.serverless/

# =========================================================================
# 4. LOGS & DIAGNOSTICS (Express and npm error logs)
# =========================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================================
# 5. TESTING & COVERAGE
# =========================================================================
coverage/
.nyc_output/
client/coverage/
frontend/coverage/

# =========================================================================
# 6. IDEs, EDITORS & SYSTEM FILES (OS specific configurations)
# =========================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
