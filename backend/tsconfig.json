
{
  "compilerOptions": {
    "target": "ES2022",                          /* Set modern JavaScript output */
    "module": "ESNext",                          /* Specify module code generation */
    "moduleResolution": "bundler",              /* Validate module imports */
    "rootDir": "./src",                          /* Point to your TS source code */
    "outDir": "./dist",                          /* Point to compiled JS output */
    "esModuleInterop": true,                     /* Emit additional JavaScript for imports */
    "forceConsistentCasingInFileNames": true,    /* Ensure correct casing in imports */
    "strict": true,                              /* Enable all strict type-checking options */
    "skipLibCheck": true                         /* Skip type checking of declaration files */
  },
  "include": ["src/**/*"]                        /* Compile only files inside src */
}
